{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "Classic Google Search",
  "version": "1.0.1",
  "description": "Bring back the classic Google Search experience by removing AI Overviews and AI Mode.",
  "author": "Classic Google Search",
  "homepage_url": "https://github.com/",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "*://www.google.com/*",
    "*://www.google.co.uk/*",
    "*://www.google.co.in/*",
    "*://www.google.co.jp/*",
    "*://www.google.ca/*",
    "*://www.google.com.au/*",
    "*://www.google.de/*",
    "*://www.google.fr/*",
    "*://www.google.es/*",
    "*://www.google.it/*",
    "*://www.google.nl/*",
    "*://www.google.be/*",
    "*://www.google.ch/*",
    "*://www.google.at/*",
    "*://www.google.se/*",
    "*://www.google.no/*",
    "*://www.google.dk/*",
    "*://www.google.fi/*",
    "*://www.google.pl/*",
    "*://www.google.pt/*",
    "*://www.google.ie/*",
    "*://www.google.co.nz/*",
    "*://www.google.com.br/*",
    "*://www.google.com.mx/*",
    "*://www.google.co.za/*",
    "*://www.google.co.kr/*",
    "*://www.google.com.sg/*",
    "*://www.google.co.id/*",
    "*://www.google.com.hk/*",
    "*://www.google.com.tw/*",
    "*://www.google.ae/*",
    "*://www.google.com.tr/*",
    "*://www.google.gr/*",
    "*://www.google.cz/*",
    "*://www.google.ro/*",
    "*://www.google.hu/*",
    "*://www.google.co.il/*",
    "*://www.google.com.sa/*",
    "*://www.google.com.eg/*",
    "*://www.google.com.ph/*",
    "*://www.google.com.vn/*",
    "*://www.google.co.th/*",
    "*://www.google.com.my/*",
    "*://www.google.com.pk/*",
    "*://www.google.com.ar/*",
    "*://www.google.cl/*",
    "*://www.google.com.co/*",
    "*://www.google.com.pe/*",
    "*://www.google.ru/*",
    "*://www.google.com.ua/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/search*",
        "*://www.google.co.uk/search*",
        "*://www.google.co.in/search*",
        "*://www.google.co.jp/search*",
        "*://www.google.ca/search*",
        "*://www.google.com.au/search*",
        "*://www.google.de/search*",
        "*://www.google.fr/search*",
        "*://www.google.es/search*",
        "*://www.google.it/search*",
        "*://www.google.nl/search*",
        "*://www.google.be/search*",
        "*://www.google.ch/search*",
        "*://www.google.at/search*",
        "*://www.google.se/search*",
        "*://www.google.no/search*",
        "*://www.google.dk/search*",
        "*://www.google.fi/search*",
        "*://www.google.pl/search*",
        "*://www.google.pt/search*",
        "*://www.google.ie/search*",
        "*://www.google.co.nz/search*",
        "*://www.google.com.br/search*",
        "*://www.google.com.mx/search*",
        "*://www.google.co.za/search*",
        "*://www.google.co.kr/search*",
        "*://www.google.com.sg/search*",
        "*://www.google.co.id/search*",
        "*://www.google.com.hk/search*",
        "*://www.google.com.tw/search*",
        "*://www.google.ae/search*",
        "*://www.google.com.tr/search*",
        "*://www.google.gr/search*",
        "*://www.google.cz/search*",
        "*://www.google.ro/search*",
        "*://www.google.hu/search*",
        "*://www.google.co.il/search*",
        "*://www.google.com.sa/search*",
        "*://www.google.com.eg/search*",
        "*://www.google.com.ph/search*",
        "*://www.google.com.vn/search*",
        "*://www.google.co.th/search*",
        "*://www.google.com.my/search*",
        "*://www.google.com.pk/search*",
        "*://www.google.com.ar/search*",
        "*://www.google.cl/search*",
        "*://www.google.com.co/search*",
        "*://www.google.com.pe/search*",
        "*://www.google.ru/search*",
        "*://www.google.com.ua/search*"
      ],
      "js": ["selectors.js", "storage.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "minimum_chrome_version": "100"
}
